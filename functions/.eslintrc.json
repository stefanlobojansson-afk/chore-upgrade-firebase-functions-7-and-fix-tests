{
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "extends": ["eslint:recommended", "google"],
  "rules": {
    "no-restricted-globals": ["error", "name", "length"],
    "prefer-arrow-callback": "error",
    "quotes": ["error", "single", {"allowTemplateLiterals": true}],
    "max-len": ["error", {"code": 120}]
  },
  "overrides": [
    {
      "files": ["**/*.spec.*", "**/test/**/*.js"],
      "env": {
        "mocha": true
      },
      "rules": {
        "require-jsdoc": "off"
      }
    }
  ],
  "globals": {},
  "env": {
    "es6": true,
    "node": true
  }
}
